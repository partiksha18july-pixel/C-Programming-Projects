
#include <stdio.h>

struct Question
{
    char question[150];
    char options[4][80];
    char answer;
};

int main()
{
    struct Question quiz[5] =
    {
        {
            "1. Which language is used for C programming?",
            {"A. English", "B. C", "C. HTML", "D. Python"},
            'B'
        },
        {
            "2. Who developed C language?",
            {"A. Dennis Ritchie", "B. James Gosling",
             "C. Charles Babbage", "D. Bill Gates"},
            'A'
        },
        {
            "3. Which symbol ends a C statement?",
            {"A. :", "B. ,", "C. ;", "D. ."},
            'C'
        },
        {
            "4. Which header file is used for printf()?",
            {"A. stdlib.h", "B. stdio.h",
             "C. math.h", "D. string.h"},
            'B'
        },
        {
            "5. Which loop executes at least once?",
            {"A. for", "B. while",
             "C. do-while", "D. None"},
            'C'
        }
    };

    int i, score = 0;
    char choice;

    printf("===== WELCOME TO THE QUIZ =====\n");

    for (i = 0; i < 5; i++)
    {
        printf("\n%s\n", quiz[i].question);

        for (int j = 0; j < 4; j++)
        {
            printf("%s\n", quiz[i].options[j]);
        }

        printf("Enter your answer (A/B/C/D): ");
        scanf(" %c", &choice);

        if (choice >= 'a' && choice <= 'z')
        {
            choice = choice - 32;
        }

        if (choice == quiz[i].answer)
        {
            printf("Correct answer!\n");
            score++;
        }
        else
        {
            printf("Wrong answer!\n");
        }
    }

    printf("\n===== QUIZ RESULT =====\n");
    printf("Your final score is: %d/5\n", score);

    if (score == 5)
    {
        printf("Excellent performance!\n");
    }
    else if (score >= 3)
    {
        printf("Good job!\n");
    }
    else
    {
        printf("Keep practising!\n");
    }

    return 0;
}
